---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found">
  <div class="max-w-4xl mx-auto px-6 py-32 text-center">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Page Not Found</h1>
    <p class="text-gray-500 mb-10">This page doesn't exist or has moved.</p>
    <a href="/" class="inline-block px-5 py-2.5 bg-nu-purple text-white rounded-lg text-sm font-medium hover:bg-nu-dark transition-colors">Go to Home</a>
  </div>
</Layout>
